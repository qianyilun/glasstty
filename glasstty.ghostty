# glasstty: a Liquid Glass look for Ghostty on macOS 26.
# https://github.com/qianyilun/glasstty
#
# Turn it on with one line in your Ghostty config that points at this file:
#   config-file = ~/path/to/glasstty/glasstty.ghostty
# Ghostty reads it after the rest of your config, wherever the line sits, so the settings below
# win. Remove the line to go back.
# Relative paths below are resolved from this file's folder.

# Colors: Apple system colors on a light #f5f5f7 base, plus the two tab bar markers the shader
# looks for (palette 200 and 204).
config-file = themes/glasstty-light

# Native clear Liquid Glass behind the window. The default background becomes transparent and
# cells with an explicit background stay opaque, which is how the shader finds tab pills,
# messages, diffs and the selection.
background-blur = macos-glass-clear
background-opacity = 0.08
background-opacity-cells = false

# The empty line clears shaders set earlier: glasstty has to see the terminal image as drawn.
# For the reading scrim alone, without glass pills and blocks, use shaders/glasstty-scrim.glsl.
custom-shader =
custom-shader = shaders/glasstty.glsl
custom-shader-animation = false

# Window chrome that suits the glass. The top padding leaves room for tab pills, which are
# taller than one row.
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
window-padding-x = 20
window-padding-y = 14
window-padding-balance = true

# Keep dark text dark on the light scrim.
minimum-contrast = 1
