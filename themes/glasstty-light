# glasstty-light: Apple-style light palette for Ghostty on macOS Liquid Glass.
# https://github.com/qianyilun/glasstty
# Normal colors 1-6: Apple system colors, increased-contrast light variants (text-safe on light glass).
# Bright colors 9-14: standard system colors where they stay >= 3:1 on #f5f5f7, else the accessible variant.
# 0 and 8 are text grays. 7 and 15 are light grays meant as backgrounds, not text; Claude Code's
# light-ansi theme draws your prompts on 7, which glasstty.glsl turns into a white glass card.
# Cursor and selection follow the default blue accent (insertion point and selected text).
background = #f5f5f7
foreground = #1d1d1f
cursor-color = #007aff
cursor-text = #ffffff
selection-background = #b3d7ff
selection-foreground = #1d1d1f
palette = 0=#1d1d1f
palette = 1=#d70015
palette = 2=#248a3d
palette = 3=#b25000
palette = 4=#0040dd
palette = 5=#8944ab
palette = 6=#0071a4
palette = 7=#c7c7cc
palette = 8=#6e6e73
palette = 9=#ff3b30
palette = 10=#0c817b
palette = 11=#c93400
palette = 12=#007aff
palette = 13=#af52de
palette = 14=#008299
palette = 15=#e5e5ea
# Glass pill markers for the tmux tab bar. glasstty.glsl matches these exact values,
# so they are kept apart from palette 12 (#007aff) and from white, which is the label color
# on the blue pill (a near-white marker made white text cores look like clear pill).
# The shader paints its own glass colors, so these are only markers; #0071e3 also stays readable
# with white text if the shader is off.
palette = 200=#0071e3
palette = 204=#ebebf0
